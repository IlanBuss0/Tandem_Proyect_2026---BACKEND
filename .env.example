PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/tandem
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
# Generar una vez con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Conservarla fuera del repositorio. Perderla impide recuperar los datos cifrados.
DATA_ENCRYPTION_KEY=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8080
# Proxies delante de la app (para que los rate limiters cuenten por visitante).
# 1 si el frontend llama directo a Railway; 2 si pasa por el rewrite /api de Vercel.
# Sin definir: 1 en produccion, desactivado en desarrollo. 0 = no confiar en ningun proxy.
# No poner mas saltos de los reales: permitiria falsificar la IP con X-Forwarded-For.
TRUST_PROXY_HOPS=
